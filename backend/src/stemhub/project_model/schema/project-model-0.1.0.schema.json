{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stemhub:project-model:0.1.0",
  "$defs": {
    "Arrangement": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^arrangement:(?:0|[1-9][0-9]{0,4})$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "pattern": "^[^\\x00]*$",
          "title": "Name",
          "type": "string"
        },
        "markers": {
          "items": {
            "$ref": "#/$defs/Marker"
          },
          "maxItems": 999,
          "title": "Markers",
          "type": "array"
        },
        "tracks": {
          "items": {
            "$ref": "#/$defs/Track"
          },
          "maxItems": 500,
          "title": "Tracks",
          "type": "array"
        },
        "extensions": {
          "additionalProperties": {
            "type": "object"
          },
          "description": "What the core objects don't model, as free-form JSON per namespace (fl_studio). At most 8 levels deep (this object is level 1) and 65536 bytes as compact UTF-8 JSON; those two caps are checked by the backend.",
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "title": "Extensions",
          "type": "object"
        }
      },
      "required": [
        "id",
        "name",
        "markers",
        "tracks"
      ],
      "title": "Arrangement",
      "type": "object"
    },
    "AudioClip": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "audio",
          "title": "Kind",
          "type": "string"
        },
        "source_id": {
          "pattern": "^audio:(?:0|[1-9][0-9]{0,4})$",
          "title": "Source Id",
          "type": "string"
        },
        "start_ticks": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Start Ticks",
          "type": "integer"
        },
        "length_ticks": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Length Ticks",
          "type": "integer"
        },
        "offset_start_ticks": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Offset Start Ticks"
        },
        "offset_end_ticks": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Offset End Ticks"
        },
        "muted": {
          "title": "Muted",
          "type": "boolean"
        },
        "extensions": {
          "additionalProperties": {
            "type": "object"
          },
          "description": "What the core objects don't model, as free-form JSON per namespace (fl_studio). At most 8 levels deep (this object is level 1) and 65536 bytes as compact UTF-8 JSON; those two caps are checked by the backend.",
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "title": "Extensions",
          "type": "object"
        }
      },
      "required": [
        "kind",
        "source_id",
        "start_ticks",
        "length_ticks",
        "offset_start_ticks",
        "offset_end_ticks",
        "muted"
      ],
      "title": "AudioClip",
      "type": "object"
    },
    "AudioSource": {
      "additionalProperties": false,
      "description": "Audio that audio clips play (FL Studio: an audio clip channel).",
      "properties": {
        "id": {
          "pattern": "^audio:(?:0|[1-9][0-9]{0,4})$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "pattern": "^[^\\x00]*$",
          "title": "Name",
          "type": "string"
        },
        "sample": {
          "anyOf": [
            {
              "oneOf": [
                {
                  "$ref": "#/$defs/ProjectSample"
                },
                {
                  "$ref": "#/$defs/FactorySample"
                },
                {
                  "$ref": "#/$defs/ExternalSample"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "title": "Sample"
        },
        "insert": {
          "oneOf": [
            {
              "$ref": "#/$defs/KnownInsert"
            },
            {
              "$ref": "#/$defs/UnknownValue"
            }
          ],
          "title": "Insert"
        },
        "extensions": {
          "additionalProperties": {
            "type": "object"
          },
          "description": "What the core objects don't model, as free-form JSON per namespace (fl_studio). At most 8 levels deep (this object is level 1) and 65536 bytes as compact UTF-8 JSON; those two caps are checked by the backend.",
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "title": "Extensions",
          "type": "object"
        }
      },
      "required": [
        "id",
        "name",
        "sample",
        "insert"
      ],
      "title": "AudioSource",
      "type": "object"
    },
    "Automation": {
      "additionalProperties": false,
      "description": "A parameter's change over time, played by automation clips. A null target is linked to nothing.",
      "properties": {
        "id": {
          "pattern": "^automation:(?:0|[1-9][0-9]{0,4})$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "pattern": "^[^\\x00]*$",
          "title": "Name",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "oneOf": [
                {
                  "$ref": "#/$defs/TempoTarget"
                },
                {
                  "$ref": "#/$defs/InstrumentTarget"
                },
                {
                  "$ref": "#/$defs/InsertTarget"
                },
                {
                  "$ref": "#/$defs/EffectSlotTarget"
                },
                {
                  "$ref": "#/$defs/UnknownValue"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "title": "Target"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/AutomationPoint"
          },
          "maxItems": 10000,
          "title": "Points",
          "type": "array"
        },
        "extensions": {
          "additionalProperties": {
            "type": "object"
          },
          "description": "What the core objects don't model, as free-form JSON per namespace (fl_studio). At most 8 levels deep (this object is level 1) and 65536 bytes as compact UTF-8 JSON; those two caps are checked by the backend.",
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "title": "Extensions",
          "type": "object"
        }
      },
      "required": [
        "id",
        "name",
        "target",
        "points"
      ],
      "title": "Automation",
      "type": "object"
    },
    "AutomationClip": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "automation",
          "title": "Kind",
          "type": "string"
        },
        "source_id": {
          "pattern": "^automation:(?:0|[1-9][0-9]{0,4})$",
          "title": "Source Id",
          "type": "string"
        },
        "start_ticks": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Start Ticks",
          "type": "integer"
        },
        "length_ticks": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Length Ticks",
          "type": "integer"
        },
        "offset_start_ticks": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Offset Start Ticks"
        },
        "offset_end_ticks": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Offset End Ticks"
        },
        "muted": {
          "title": "Muted",
          "type": "boolean"
        },
        "extensions": {
          "additionalProperties": {
            "type": "object"
          },
          "description": "What the core objects don't model, as free-form JSON per namespace (fl_studio). At most 8 levels deep (this object is level 1) and 65536 bytes as compact UTF-8 JSON; those two caps are checked by the backend.",
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "title": "Extensions",
          "type": "object"
        }
      },
      "required": [
        "kind",
        "source_id",
        "start_ticks",
        "length_ticks",
        "offset_start_ticks",
        "offset_end_ticks",
        "muted"
      ],
      "title": "AutomationClip",
      "type": "object"
    },
    "AutomationPoint": {
      "additionalProperties": false,
      "properties": {
        "position_ticks": {
          "description": "From the start of the automation clip.",
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Position Ticks",
          "type": "integer"
        },
        "value": {
          "description": "The parameter's normalized value.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Value",
          "type": "number"
        },
        "tension": {
          "maximum": 1.0,
          "minimum": -1.0,
          "title": "Tension",
          "type": "number"
        }
      },
      "required": [
        "position_ticks",
        "value",
        "tension"
      ],
      "title": "AutomationPoint",
      "type": "object"
    },
    "EffectSlot": {
      "additionalProperties": false,
      "properties": {
        "index": {
          "description": "0-based; FL Studio shows it as index + 1.",
          "maximum": 9,
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "dry_wet": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Dry Wet",
          "type": "number"
        },
        "plugin": {
          "$ref": "#/$defs/Plugin"
        },
        "extensions": {
          "additionalProperties": {
            "type": "object"
          },
          "description": "What the core objects don't model, as free-form JSON per namespace (fl_studio). At most 8 levels deep (this object is level 1) and 65536 bytes as compact UTF-8 JSON; those two caps are checked by the backend.",
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "title": "Extensions",
          "type": "object"
        }
      },
      "required": [
        "index",
        "enabled",
        "dry_wet",
        "plugin"
      ],
      "title": "EffectSlot",
      "type": "object"
    },
    "EffectSlotTarget": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "effect_slot",
          "title": "Kind",
          "type": "string"
        },
        "insert_id": {
          "pattern": "^insert:(?:[0-9]|[1-9][0-9]|1[01][0-9]|12[0-6])$",
          "title": "Insert Id",
          "type": "string"
        },
        "slot_index": {
          "description": "0-based; FL Studio shows it as index + 1.",
          "maximum": 9,
          "minimum": 0,
          "title": "Slot Index",
          "type": "integer"
        },
        "parameter": {
          "enum": [
            "enabled",
            "dry_wet"
          ],
          "title": "Parameter",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "insert_id",
        "slot_index",
        "parameter"
      ],
      "title": "EffectSlotTarget",
      "type": "object"
    },
    "ExternalSample": {
      "additionalProperties": false,
      "description": "A sample outside the project folder: only its file name is kept, never its folder.",
      "properties": {
        "location": {
          "const": "external",
          "title": "Location",
          "type": "string"
        },
        "file_name": {
          "description": "A file name without its folder: one segment of an asset path, without bidirectional controls.",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^/\\\\:\\x00-\\x1f\\x7f\\u202a-\\u202e\\u2066-\\u2069]*[^/\\\\:\\x00-\\x1f\\x7f\\u202a-\\u202e\\u2066-\\u2069. ]$",
          "title": "File Name",
          "type": "string"
        }
      },
      "required": [
        "location",
        "file_name"
      ],
      "title": "ExternalSample",
      "type": "object"
    },
    "FactorySample": {
      "additionalProperties": false,
      "description": "A sample shipped with FL Studio, under its %FL...% folder variable.",
      "properties": {
        "location": {
          "const": "factory",
          "title": "Location",
          "type": "string"
        },
        "path": {
          "description": "Path under one of FL Studio's %FL...% folder variables, '/'-separated.",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^%FL[A-Za-z0-9]+%(?:/[^/\\\\:\\x00-\\x1f\\x7f]*[^/\\\\:\\x00-\\x1f\\x7f. ])+$",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "location",
        "path"
      ],
      "title": "FactorySample",
      "type": "object"
    },
    "Generator": {
      "additionalProperties": false,
      "description": "What wrote the document.",
      "properties": {
        "name": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "pattern": "^[\\x21-\\x7e]{1,64}$",
          "title": "Version",
          "type": "string"
        },
        "pyflp": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{7,40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The PyFLP commit the reader used.",
          "title": "Pyflp"
        }
      },
      "required": [
        "name",
        "version",
        "pyflp"
      ],
      "title": "Generator",
      "type": "object"
    },
    "Insert": {
      "additionalProperties": false,
      "description": "One mixer insert; insert 0 is the Master insert. An insert that isn't listed has default values.",
      "properties": {
        "id": {
          "pattern": "^insert:(?:[0-9]|[1-9][0-9]|1[01][0-9]|12[0-6])$",
          "title": "Id",
          "type": "string"
        },
        "number": {
          "maximum": 126,
          "minimum": 0,
          "title": "Number",
          "type": "integer"
        },
        "name": {
          "maxLength": 255,
          "pattern": "^[^\\x00]*$",
          "title": "Name",
          "type": "string"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "volume": {
          "$ref": "#/$defs/InsertVolume"
        },
        "pan": {
          "description": "-1 is fully left, 0 centred, +1 fully right.",
          "maximum": 1.0,
          "minimum": -1.0,
          "title": "Pan",
          "type": "number"
        },
        "stereo_separation": {
          "description": "+1 fully separated, 0 unchanged, -1 merged (mono).",
          "maximum": 1.0,
          "minimum": -1.0,
          "title": "Stereo Separation",
          "type": "number"
        },
        "sends": {
          "items": {
            "$ref": "#/$defs/Send"
          },
          "maxItems": 126,
          "title": "Sends",
          "type": "array"
        },
        "effect_slots": {
          "items": {
            "$ref": "#/$defs/EffectSlot"
          },
          "maxItems": 10,
          "title": "Effect Slots",
          "type": "array"
        },
        "extensions": {
          "additionalProperties": {
            "type": "object"
          },
          "description": "What the core objects don't model, as free-form JSON per namespace (fl_studio). At most 8 levels deep (this object is level 1) and 65536 bytes as compact UTF-8 JSON; those two caps are checked by the backend.",
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "title": "Extensions",
          "type": "object"
        }
      },
      "required": [
        "id",
        "number",
        "name",
        "enabled",
        "volume",
        "pan",
        "stereo_separation",
        "sends",
        "effect_slots"
      ],
      "title": "Insert",
      "type": "object"
    },
    "InsertTarget": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "insert",
          "title": "Kind",
          "type": "string"
        },
        "insert_id": {
          "pattern": "^insert:(?:[0-9]|[1-9][0-9]|1[01][0-9]|12[0-6])$",
          "title": "Insert Id",
          "type": "string"
        },
        "parameter": {
          "enum": [
            "volume",
            "pan",
            "stereo_separation"
          ],
          "title": "Parameter",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "insert_id",
        "parameter"
      ],
      "title": "InsertTarget",
      "type": "object"
    },
    "InsertVolume": {
      "additionalProperties": false,
      "description": "A mixer insert's volume, up to FL Studio's 125%.",
      "properties": {
        "fader": {
          "description": "Fader position: FL raw / 12800, so 1.0 is FL Studio's 100%.",
          "maximum": 1.25,
          "minimum": 0.0,
          "title": "Fader",
          "type": "number"
        },
        "db": {
          "const": null,
          "description": "Volume in dB: always null in 0.1.0, until the fader-to-dB curve is calibrated (M2).",
          "title": "Db",
          "type": "null"
        }
      },
      "required": [
        "fader",
        "db"
      ],
      "title": "InsertVolume",
      "type": "object"
    },
    "InstrumentTarget": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "instrument",
          "title": "Kind",
          "type": "string"
        },
        "instrument_id": {
          "pattern": "^instrument:(?:0|[1-9][0-9]{0,4})$",
          "title": "Instrument Id",
          "type": "string"
        },
        "parameter": {
          "enum": [
            "volume",
            "pan"
          ],
          "title": "Parameter",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "instrument_id",
        "parameter"
      ],
      "title": "InstrumentTarget",
      "type": "object"
    },
    "InstrumentVolume": {
      "additionalProperties": false,
      "description": "An instrument's volume (FL Studio: a channel's), up to FL Studio's 100%.",
      "properties": {
        "fader": {
          "description": "Fader position: FL raw / 12800, so 1.0 is FL Studio's 100%.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Fader",
          "type": "number"
        },
        "db": {
          "const": null,
          "description": "Volume in dB: always null in 0.1.0, until the fader-to-dB curve is calibrated (M2).",
          "title": "Db",
          "type": "null"
        }
      },
      "required": [
        "fader",
        "db"
      ],
      "title": "InstrumentVolume",
      "type": "object"
    },
    "KnownInsert": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "known",
          "title": "Status",
          "type": "string"
        },
        "insert_id": {
          "pattern": "^insert:(?:[0-9]|[1-9][0-9]|1[01][0-9]|12[0-6])$",
          "title": "Insert Id",
          "type": "string"
        }
      },
      "required": [
        "status",
        "insert_id"
      ],
      "title": "KnownInsert",
      "type": "object"
    },
    "Marker": {
      "additionalProperties": false,
      "properties": {
        "position_ticks": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Position Ticks",
          "type": "integer"
        },
        "name": {
          "maxLength": 255,
          "pattern": "^[^\\x00]*$",
          "title": "Name",
          "type": "string"
        },
        "extensions": {
          "additionalProperties": {
            "type": "object"
          },
          "description": "What the core objects don't model, as free-form JSON per namespace (fl_studio). At most 8 levels deep (this object is level 1) and 65536 bytes as compact UTF-8 JSON; those two caps are checked by the backend.",
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "title": "Extensions",
          "type": "object"
        }
      },
      "required": [
        "position_ticks",
        "name"
      ],
      "title": "Marker",
      "type": "object"
    },
    "Mixer": {
      "additionalProperties": false,
      "properties": {
        "inserts": {
          "items": {
            "$ref": "#/$defs/Insert"
          },
          "maxItems": 127,
          "title": "Inserts",
          "type": "array"
        },
        "extensions": {
          "additionalProperties": {
            "type": "object"
          },
          "description": "What the core objects don't model, as free-form JSON per namespace (fl_studio). At most 8 levels deep (this object is level 1) and 65536 bytes as compact UTF-8 JSON; those two caps are checked by the backend.",
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "title": "Extensions",
          "type": "object"
        }
      },
      "required": [
        "inserts"
      ],
      "title": "Mixer",
      "type": "object"
    },
    "ModelWarning": {
      "additionalProperties": false,
      "description": "Something read with a loss, e.g. text with invalid characters replaced.",
      "properties": {
        "path": {
          "description": "An RFC 6901 JSON pointer.",
          "maxLength": 512,
          "pattern": "^(?:/(?:[^~/\\x00]|~[01])*)*$",
          "title": "Path",
          "type": "string"
        },
        "message": {
          "maxLength": 500,
          "minLength": 1,
          "pattern": "^[^\\x00]*$",
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "path",
        "message"
      ],
      "title": "ModelWarning",
      "type": "object"
    },
    "Note": {
      "additionalProperties": false,
      "properties": {
        "instrument_id": {
          "pattern": "^instrument:(?:0|[1-9][0-9]{0,4})$",
          "title": "Instrument Id",
          "type": "string"
        },
        "pitch": {
          "description": "FL Studio's key number, as MIDI: 60 is middle C.",
          "maximum": 131,
          "minimum": 0,
          "title": "Pitch",
          "type": "integer"
        },
        "start_ticks": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Start Ticks",
          "type": "integer"
        },
        "length_ticks": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Length Ticks",
          "type": "integer"
        },
        "velocity": {
