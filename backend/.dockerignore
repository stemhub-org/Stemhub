# Build context for the backend image (docker-compose.yml: context ./backend).

# Local environments, caches and build output, at any depth
**/.venv*
**/__pycache__
**/*.py[cod]
**/build
**/*.egg-info
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.tox

# Coverage output
**/htmlcov
**/.coverage
**/.coverage.*
**/coverage.xml

# Local data, credentials and settings: never part of the image
uploads
data
.secrets
**/.env
**/.env.*

# PyFLP_v2 submodule: its sources are installed by the Dockerfile. Its .git is
# a link into the superproject's .git, which is outside the build context, and
# _version.py is regenerated by setuptools_scm during the install.
vendor/PyFLP_v2/.git
vendor/PyFLP_v2/pyflp/_version.py
